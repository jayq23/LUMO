# Backend Environment Variables for Render
# Update these for your deployment

# Server Configuration
NODE_ENV=production
PORT=3000

#supabase: connection string: 
DATABASE_URL= your postgresql_connection_string_here

# JWT Secret - Generate a strong random string (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_at_least_32_chars

# Firebase Admin SDK (Optional - for OAuth token verification)
# Leave as {} or empty if not using Firebase Admin verification
FIREBASE_SERVICE_ACCOUNT={}

# CORS - Allow your Vercel frontend domain
CORS_ORIGIN=https://your-app.vercel.app

# Groq API Key (get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
