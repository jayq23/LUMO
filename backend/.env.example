# Backend Environment Variables for Render
# Update these for your deployment

# Server Configuration
NODE_ENV=production
PORT=3000

# Database - Use Render PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/expensetracker
# Render: postgresql://user:password@dpg-xxxxx.onrender.com:5432/expensetracker
DATABASE_URL=postgresql://user:password@your-render-db.onrender.com:5432/expensetracker

# JWT Secret - Generate a strong random string (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_at_least_32_chars

# Firebase Admin SDK (Optional - for OAuth token verification)
# Leave as {} or empty if not using Firebase Admin verification
FIREBASE_SERVICE_ACCOUNT={}

# CORS - Allow your Vercel frontend domain
CORS_ORIGIN=https://your-app.vercel.app
